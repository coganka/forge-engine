# Build output and downloaded dependencies
/build/
/vendor/
*.o
*.a
*.dylib
*.dSYM/
*.air
*.metallib

# Downloaded model assets (keep source and license notes)
/resources/models/*.obj
/resources/models/*.zip

# macOS and temporary files
.DS_Store
._*
*.log
*.swp
*.swo
*~

# Local credentials and environment
.env
.env.*
!.env.example

# Local assistant settings
.codex/
.claude/

# Share project tasks and IntelliSense settings only
/.vscode/*
!/.vscode/tasks.json
!/.vscode/c_cpp_properties.json
!/.vscode/extensions.json

